# ─── 模型(OpenAI 兼容接口;以下为火山方舟 ARK 示例,也可换 DeepSeek/OpenAI 等)───
FLOWAGENT_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
FLOWAGENT_API_KEY=xxxxxx
FLOWAGENT_MODEL=glm-5.3-flash
# 专家模式模型(可换更强的模型 ID;不设置则专家模式回退使用 FLOWAGENT_MODEL)
# FLOWAGENT_MODEL_EXPERT=

# ─── Flow 流程仓库根目录(需含 rules/ agent/ config/;不设置则使用内置 demo)───
# FLOW_WORKFLOW_ROOT=/path/to/RNAFlow

# ─── HTTP 服务 ───
# 绑定地址:默认 127.0.0.1(仅本机);对局域网开放时显式设 0.0.0.0,并务必同时配置鉴权
# FLOWAGENT_HOST=127.0.0.1
FLOWAGENT_PORT=3090
# Bearer 鉴权:设置后 /api/chat 与 /api/mode 要求 Authorization: Bearer <token>;
# 前端 useChat 请求头带 token 需配 transport 的 headers。不设置则不鉴权(仅靠绑定回环地址兜底)
# FLOWAGENT_AUTH_TOKEN=
# CORS 允许来源:缺省为 localhost/127.0.0.1 任意端口;逗号分隔精确匹配;"*" 恢复全开(不建议)
# FLOWAGENT_ALLOWED_ORIGINS=http://localhost:5173,http://192.168.1.10:5173

# ─── 正式提交开关:默认关闭;即使开启,无本任务 dry-run 通过记录也一律拒绝(硬约束)───
# FLOWAGENT_ALLOW_SUBMIT=true
# FLOWAGENT_CORES=8

# ─── conda 环境(rule 的 conda: envs/*.yaml 由 snakemake 自动建环境;默认开启)───
# FLOWAGENT_USE_CONDA=true
# FLOWAGENT_CONDA_FRONTEND=conda        # 装了 mamba/micromamba 可改 mamba 提速

# ─── submit 追加参数(真实 Flow 仓库的强制 logger 插件等)───
# FLOWAGENT_EXTRA_ARGS="--logger rich-loguru"
